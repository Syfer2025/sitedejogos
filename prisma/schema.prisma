generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Game {
  id              String           @id @default(cuid())
  title           String
  slug            String           @unique
  iframeUrl       String
  thumbnail       String
  description     String           @default("")
  category        String           @default("")
  tags            String           @default("")
  externalSource  String?
  externalId      String?
  featured        Boolean          @default(false)
  views           Int              @default(0)
  popularityScore Int              @default(0)
  isPublished     Boolean          @default(true)
  longDescription String           @default("")
  tips            String           @default("")
  controls        String           @default("")
  faqJson         String           @default("")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  analyticsEvents AnalyticsEvent[]
  favorites       FavoriteGame[]
  comments        GameComment[]
  ratings         GameRating[]
  history         RecentlyPlayed[]

  @@unique([externalSource, externalId])
  @@index([isPublished, featured])
  @@index([category])
  @@index([views, popularityScore])
  @@index([externalSource])
}

model AdminSession {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model User {
  id                     String               @id @default(cuid())
  email                  String               @unique
  emailVerified          DateTime?
  displayName            String
  image                  String               @default("")
  passwordHash           String?
  avatarUrl              String               @default("")
  coverUrl               String               @default("")
  bio                    String               @default("")
  preferredCategories    String               @default("")
  xp                     Int                  @default(0)
  level                  Int                  @default(1)
  currentStreak          Int                  @default(0)
  longestStreak          Int                  @default(0)
  lastEngagedAt          DateTime?
  isPremium              Boolean              @default(false)
  premiumUntil           DateTime?
  coins                  Int                  @default(0)
  profileTheme           String               @default("default")
  unlockedAvatars        String               @default("")
  unlockedCovers         String               @default("")
  isPublicProfile        Boolean              @default(true)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  hadFreeTrial           Boolean              @default(false)
  accounts               Account[]
  analyticsEvents        AnalyticsEvent[]
  coinTransactions       CoinTransaction[]
  favorites              FavoriteGame[]
  receivedFriendRequests Friendship[]         @relation("FriendshipReceiver")
  sentFriendRequests     Friendship[]         @relation("FriendshipSender")
  comments               GameComment[]
  ratings                GameRating[]
  achievements           PlayerAchievement[]
  dailyMissions          PlayerDailyMission[]
  notifications          PlayerNotification[]
  sessions               PlayerSession[]
  history                RecentlyPlayed[]
  rewardedAdViews        RewardedAdView[]
  totpDevice             TotpDevice?

  @@map("PlayerUser")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model TotpDevice {
  id              String   @id @default(cuid())
  userId          String   @unique
  encryptedSecret String
  iv              String
  backupCodes     String   @default("")
  isEnabled       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PlayerSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model FavoriteGame {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  createdAt DateTime @default(now())
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([userId, createdAt])
}

model RecentlyPlayed {
  id           String   @id @default(cuid())
  userId       String
  gameId       String
  playCount    Int      @default(1)
  lastPlayedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  game         Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([userId, lastPlayedAt])
}

model AnalyticsEvent {
  id              String   @id @default(cuid())
  type            String
  path            String
  destinationPath String?
  sessionId       String?
  userId          String?
  gameId          String?
  referrer        String?
  createdAt       DateTime @default(now())
  game            Game?    @relation(fields: [gameId], references: [id])
  user            User?    @relation(fields: [userId], references: [id])

  @@index([type, createdAt])
  @@index([path, createdAt])
  @@index([destinationPath, createdAt])
  @@index([sessionId, createdAt])
  @@index([userId, createdAt])
  @@index([gameId, createdAt])
}

model PlayerAchievement {
  id          String   @id @default(cuid())
  userId      String
  key         String
  title       String
  description String
  icon        String
  imageUrl    String   @default("")
  xpReward    Int      @default(0)
  coinReward  Int      @default(0)
  unlockedAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId, unlockedAt])
}

model AchievementDefinition {
  id           String   @id @default(cuid())
  key          String   @unique
  title        String
  description  String
  icon         String   @default("")
  imageUrl     String   @default("")
  criteriaType String
  threshold    Int      @default(1)
  xpReward     Int      @default(0)
  coinReward   Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, criteriaType])
  @@index([createdAt])
}

model BlogPost {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  category      String    @default("")
  coverImageUrl String    @default("")
  excerpt       String    @default("")
  content       String
  readingTime   String    @default("1 min")
  isPublished   Boolean   @default(false)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([isPublished, publishedAt])
  @@index([createdAt])
}

model PlayerNotification {
  id        String    @id @default(cuid())
  userId    String
  kind      String
  title     String
  message   String
  link      String    @default("")
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())
  readAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, isRead, createdAt])
}

model PlayerDailyMission {
  id            String    @id @default(cuid())
  userId        String
  dayToken      String
  kind          String
  targetCount   Int       @default(1)
  progressCount Int       @default(0)
  rewardXp      Int       @default(0)
  isCompleted   Boolean   @default(false)
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayToken])
  @@index([dayToken, isCompleted])
}

model Friendship {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  receiver   User     @relation("FriendshipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User     @relation("FriendshipSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@index([senderId, status])
}

model GameComment {
  id        String   @id @default(cuid())
  gameId    String
  userId    String
  content   String
  isHidden  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gameId, createdAt])
  @@index([userId, createdAt])
}

model CoinTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model GameRating {
  id        String   @id @default(cuid())
  gameId    String
  userId    String
  value     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([gameId, value])
}

model RewardedAdView {
  id           String   @id @default(cuid())
  userId       String
  rewardType   String
  rewardAmount Int      @default(50)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model CategoryContent {
  category        String   @id
  h1              String   @default("")
  metaTitle       String   @default("")
  metaDescription String   @default("")
  intro           String   @default("")
  body            String   @default("")
  benefitsJson    String   @default("[]")
  faqJson         String   @default("[]")
  generatedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ──────────────────────────────────────────
// Web Push Subscriptions
// ──────────────────────────────────────────
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  locale       String   @default("pt-BR")
  subscribedAt DateTime @default(now())
  active       Boolean  @default(true)

  @@index([active, subscribedAt])
}
